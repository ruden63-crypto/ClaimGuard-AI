            const demoText = `// ClaimGuard AI - Core Smart Contract Module\n// Developer: Beisenbay Bauyrzhan\n\nfunction verifyCopyrightProof(bytes32 fileHash, address author) public {\n    require(msg.sender == author, "Unauthorized author signature");\n    bytes32 timestamp = block.timestamp;\n    emit IPRegistered(fileHash, author, timestamp);\n}`;
            document.getElementById('audit-input').value = demoText;
        }

        function runAuditScanner() {
            const input = document.getElementById('audit-input').value.trim();
            if (!input) {
                alert(currentLang === 'ru' ? 'Пожалуйста, введите код или текст!' : 'Please enter code or text!');
                return;
            }

            const overlay = document.getElementById('scan-overlay');
            const btn = document.getElementById('audit-btn');
            
            overlay.classList.remove('hidden');
            btn.disabled = true;

            setTimeout(() => {
                overlay.classList.add('hidden');
                btn.disabled = false;

                const humanRatio = Math.floor(Math.random() * (90 - 65 + 1)) + 65;
                const aiRatio = 100 - humanRatio;

                document.getElementById('audit-placeholder').classList.add('hidden');
                document.getElementById('audit-results').classList.remove('hidden');
                document.getElementById('audit-actions').classList.remove('hidden');

                document.getElementById('val-human').innerText = humanRatio + '%';
                document.getElementById('val-ai').innerText = aiRatio + '%';

                document.getElementById('bar-human').style.width = humanRatio + '%';
                document.getElementById('bar-ai').style.width = aiRatio + '%';
            }, 1500);
        }

