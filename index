            const violator = document.getElementById('claim-violator').value || "[Target]";
            const url = document.getElementById('claim-url').value || "[URL]";

            let text = "";
            if (type === 'dmca') {
                text = `OFFICIAL DMCA TAKEDOWN NOTICE\nTo: Content Abuse Team / Platform Administrator\n\nI am writing to notify you of unauthorized copyright infringement on your platform.\n\nInfringing Resource: ${violator}\nURL of Infringement: ${url}\n\nOriginal Work Rights Holder: Бейсенбай Бауыржан (ClaimGuard AI IP Registry)\n\nI have a good faith belief that the use of the material is not authorized by the copyright owner. I request immediate removal of the specified content.`;
            } else {
                text = `ДОСУДЕБНАЯ ПРЕТЕНЗИЯ\nВ соответствии с Законом РК «Об авторском праве и смежных правах» № 6-I\n\nКому: Администрации ресурса ${violator}\nАдрес/URL: ${url}\n\nНастоящим уведомляю, что на указанном ресурсе незаконно размещены материалы, интеллектуальные права на которые принадлежат автору Бейсенбай Б.\n\nТРЕБУЮ:\n1. Незамедлительно прекратить использование и удалить скопированный объект.\n2. В противном случае дело будет передано в Департамент юстиции РК.`;
